[Unit]
Description=Simple API
After=network.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/simple-api
ExecStart=/opt/simple-api/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Environment=PYTHONUNBUFFERED=1

# logs: systemd (root) opens the file, the app just writes to stdout/stderr
StandardOutput=append:/home/logs/app.log
StandardError=inherit

# resource limits
MemoryMax=256M
CPUQuota=50%
TasksMax=50

# self-healing
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
